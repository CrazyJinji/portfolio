# ---------------------------------------------------------------------------
# Gmail account used to send contact-form messages.
# EMAIL_PASS is a Google App Password (16 chars, no spaces), NOT the account
# password. Never commit the real values - this file is the template only.
# ---------------------------------------------------------------------------
EMAIL_USER=you@example.com
EMAIL_PASS=xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Public base URL of the deployed site, no trailing slash.
# Used by sitemap.xml, robots.txt, the canonical tag and the Open Graph tags.
#
# Server-side only - deliberately NOT prefixed with NEXT_PUBLIC_, so it is
# never inlined into the browser bundle.
#
# On Vercel this is optional: if unset, VERCEL_PROJECT_PRODUCTION_URL is used
# automatically. Set it explicitly when using a custom domain.
# ---------------------------------------------------------------------------
SITE_URL=https://your-domain.com
